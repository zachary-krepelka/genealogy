#!/usr/bin/env -S jq -rf

# FILENAME: treeify
# AUTHOR: Zachary Krepelka
# DATE: Thursday, June 18th, 2026
# ABOUT: a wrapper for the LaTeX genealogytree package
# ORIGIN: https://github.com/zachary-krepelka/genealogy.git
# UPDATED: Friday, September 11th, 2026 at 5:34 AM

def config:
	if $ARGS.named | has("config") then
		$ARGS.named.config # return the user-supplied configuration
		| if type == "array" then
				.[0] # if passed via --slurpfile config file
			else
				. # if passed via --argjson config string
			end
	else # return the default configurtation
		{
			template: "signpost",
			pretty_print: true,
			indent_string: "  ",    # if pretty-printing
			reduce_output: false,   # if the template supports it
			display_images: true,   # if the template supports it
			exclude_partners: false
		}
	end;

def haspath(candidate):
	IN(paths; candidate);

def get_gender:
	.gender // "neuter";

def get_full_name:
	[
	.name,
	.name.prefix?,
	.name.first?,
	.name.middle?,
	.name.last?,
	.name.last?.maiden?,
	.name.last?.married?,
	.name.suffix?
	] | map(strings) | join(" ");

def get_template:
	config.template
	| . as $base_template
	| if config.display_images and (endswith("pole") or endswith("sideways")) then
			add(., "portrait")
		end
	| {
			"signpost":             false,
			"database pole":        true,
			"database portrait":    true,
			"database traditional": true,
			"database sideways":    true
		} as $supports_reduction
	| if config.reduce_output and $supports_reduction[$base_template] then
			add(., " reduced")
		end;

def get_processing:
	{
		"signpost":             "literal",
		"database pole":        "structured",
		"database portrait":    "structured",
		"database traditional": "structured",
		"database sideways":    "structured",
	}[config.template];

def gen_node_options:
	{
		literal: get_gender,
		structured: ""
	}[get_processing];

def gen_node_content:
	{
		literal: get_full_name,
		structured: [
			{
				name: get_full_name,
				sex: get_gender,
			},
			if haspath(["events", "birth", "date"]) then
				{ birth: [.events.birth.date, ""] }
			else
				{}
			end,
			if haspath(["events", "death", "date"]) then
				{ death: [.events.death.date, ""] }
			else
				{}
			end,
			if config.display_images and has("image") then
				{image}
			else
				{}
			end
		] | add
	}[get_processing];

def get_indentation(number_of_indents):
	number_of_indents * config.indent_string;

def indent_text_block(number_of_indents):
	add("\n", .) | gsub("\n\\K"; get_indentation(number_of_indents));

def pad_str(len):
	add(., " " * (len - length));

def format_node_syntax(type_chr; options; content):

	( options
		| if type == "array" then
				join(",")
			end
	) as $options_str |

	( content
		| if type == "object" then
				(keys | max_by(length) | length) as $max_key_len
				| to_entries
				| map(add(
					(.key
					| if config.pretty_print then
							pad_str($max_key_len)
						end),
					("="
					| if config.pretty_print then
							" \(.) "
						end),
					(.value
					| if type == "array" then
							map("{\(.)}") | add
						else
							"{\(.)}"
						end)
					))
				| if config.pretty_print then
						join(",\n") | indent_text_block(1) | add(., "\n")
					else
						join(",")
					end
			end
	) as $content_str |

	"\(type_chr)[\($options_str)]{\($content_str)}";

def gen_node(node_type):
	format_node_syntax(node_type; gen_node_options; gen_node_content);

def gen_leaf(indents; node_def):
	node_def
	| if config.pretty_print then
			indent_text_block(indents)
		end;

def gen_branch(fam_type; is_phantom; indents; head_of_fam; rest_of_fam):
	if is_phantom then
		add(gen_leaf(indents; head_of_fam), rest_of_fam)
	else
		if config.pretty_print then
			add(
				("\(fam_type) {" | indent_text_block(indents)),
				gen_leaf(indents + 1; head_of_fam),
				rest_of_fam,
				("}" | indent_text_block(indents))
			)
			| if indents == 0 then .[1:] end # strip initial newline
		else
			"\(fam_type){\(head_of_fam)\(rest_of_fam)}"
		end
	end;

def with_indices:
	to_entries | map(.value + {index: .key});

def get_children:
	.children | sort_by(.sibling_index, .events.birth.date)?;

def treeify(context):
	if .partners and (config.exclude_partners | not) then # 1, 2
		gen_branch("child"; false; context.indents;
			gen_node("g");
			. as $consanguineal_partner
			| add(
					.partners
					| foreach with_indices[] as $affinal_partner
						(
							null;
							$affinal_partner.index == 0 as $is_first_union
							| gen_branch("union"; $is_first_union; context.indents + 1;
									$affinal_partner | gen_node("p");
									add(
										$consanguineal_partner
										| get_children[]?
										| select(.parent_index == $affinal_partner.index)
										| treeify(
												context
												| .depth += 1
												| .indents += if $is_first_union then 1 else 2 end
											)
										#
									) // "" # occurs when unions are childless
								)
							#
						)
					#
				)
			#
		)
	elif .children then # 3
		gen_branch("child"; false; context.indents;
			gen_node("g");
			add(
				get_children[]
				| treeify(
						context
						| .depth += 1
						| .indents += 1
					)
				#
			)
		)
	else # 4
		gen_leaf(context.indents; gen_node("c"))
	end;

# ------------------------------------------------------------------------------
# COMMENTARY on the implementation of treeify/1
# ------------------------------------------------------------------------------

# To exhaust possibilities, we map code paths (marked above) to a truth table.

#  PARTNERS  CHILDREN  CODE PATH  RECURSION
#  yes       yes       1          non-terminal
#  yes       no        2          terminal
#  no        yes       3          non-terminal
#  no        no        4          terminal

# With a heavy bias towards biological relationships, we view partnership as a
# precondition for having children, so we expect most cases to be handled in
# code path one-two.  Code path three is largely supplied for circumstances
# where the affine parent is unknown.  This comes up often.  The identity of a
# parent may be completely unknown, or more often the case, it may not be known
# offhand in casual conversation when acquiring information from loosely
# connected family members.

# We should take care to note circumstances where a child is included in one
# code path but excluded in another.  When a consanguineal individual has a list
# of partners but children which are not bound to one of those partners, (e.g.,
# .parent_index is missing, null, or out of bounds for some of the children),
# then those children will be excluded in code path one-two but not in code path
# three.  Adoptees and step-children, if not bound to two parents, are subject
# to the same behavior.  That is, adoptions by couples are okay, but adoptions
# by a single individual are problematic.

# Ideally, code path one-two should handle these "leftover" children.  However,
# this is not straightforward because if children were prioritized over partners
# instead, then non-childbearing partners would be leftover, so it is not enough
# to group by / iterate over the partners or the children alone.

# This is left as a TODO.

# ------------------------------------------------------------------------------

# If I was a sensible person, I would have named this function
# `get_max_depth`, but instead we are using nautical metaphors.

def plumb_by(f):
	def plumb(line): # as in the phrase "to plumb the depths of"
		if f then
			f[] | plumb(line + 1) # the sailor is lowering the line
		else
			line # the plummet touches the ocean floor
		end;
	[plumb(0)] | max;

def main:
	plumb_by(.children) as $depth
	| add(
		"\\documentclass{standalone}\n",
		"\\usepackage[all]{genealogytree}\n",
		"\\usepackage{lmodern}\n",
		"\\begin{document}\n",
		"\\begin{tikzpicture}\n",
		"\\genealogytree[\n",
		"\(get_indentation(1))template=\(get_template),\n",
		"\(get_indentation(1))insert phantom for childless families,\n",
		"\(get_indentation(1))insert for childless families level limit = -\($depth)\n",
		"]{\n",
		treeify({
			depth: 0,
			indents: 0
		}),
		"}\n",
		"\\end{tikzpicture}\n",
		"\\end{document}"
	);

main

# =pod
#
# =head1 NAME
#
# treeify - a wrapper for the LaTeX genealogytree package
#
# =head1 SYNOPSIS
#
# =head2 Usage
#
#  jq -rf treeify [--slurpfile config FILE | --argjson config STRING] FILE
#
# =head2 Example
#
#  jq -rf treeify --slurpfile config.json family-tree.json > family-tree.tex
#
# =head2 Documentation
#
#  sed -n '/^# =pod/,/^# =cut/{s/# \?//;p}' treeify \
#  | pod2text \
#  | less -Sp '^[^ ].*$' +k
#
# =head1 DESCRIPTION
#
# This program generates LaTeX source code from a custom JSON structure that,
# when compiled, renders a family tree diagram.  In particular, this program
# generates a descendancy chart which shows every descendant of a chosen
# progenitor.  Support for other diagram types like ancestry charts may be added
# in the future.  The LaTeX genealogytree package is used, and this program
# outputs to its syntax.  The input is a JSON file of the following
# (Backus-Naur-like) form.  See the example section if this is unclear.
#
#  | PERSON ::= {
#  |   "name": NAME
#  |   (, "gender": GENDER)?
#  |   (, "events": EVENTS)?
#  |   (, "children": [ PERSON... ])?
#  |   (, "partners": [ PERSON... ])?
#  |   (, "parent_index": NUMBER)?
#  |   (, "sibling_index": NUMBER)?
#  |   (, "image": FILEPATH)?
#  | }
#  |
#  | NAME ::= STRING or
#  | {
#  |   "first":  STRING,
#  |   "middle": STRING,
#  |   "last":   STRING or
#  |   {
#  |     "maiden":  STRING,
#  |     "married": STRING
#  |   },
#  |   "prefix": STRING,
#  |   "suffix": STRING
#  | }
#  |
#  | GENDER ::= "male" or "female" or null
#  |
#  | EVENTS ::= {
#  |   "birth": {
#  |     "date": STRING_IN_ISO_DATE_FORMAT
#  |   }
#  |   (, "death": {
#  |        "date": STRING_IN_ISO_DATE_FORMAT
#  |      }
#  |   )?
#  | }
#
# A design goal is to separate content from presentation.  The LaTeX
# genealogytree package creates nice-looking diagrams, and I prefer it over
# other genealogical diagramming software due to its WYSIWYM paradigm, but it
# uses an obscure and inflexible syntax that is generally hard to deal with at
# scale.  It would be better to store the data in a general-purpose,
# industry-standard data exchange format, like JSON, and then render a genealogy
# tree from that.  This would allow for extensibility of the dataset with
# arbitrary information.  The intent is similar to that of Florian Brucker's
# program C<gedcom2gtr>.  On that note, this program may have alternatively been
# called C<json2gtr>.
#
# =head1 OPTIONS
#
# Configuration may be passed in a JSON object either as a file or as a string
# using one of these two flags on the command line.
#
# =over
#
# =item --slurpfile config FILE
#
# =item --argjson config STRING
#
# =back
#
# The default configuration is shown below, and any user-supplied configuration
# must have all of the same keys.
#
#  {
#    "template": "signpost",
#    "pretty_print": true,
#    "indent_string": "  ",
#    "reduce_output": false,
#    "display_images": true,
#    "exclude_partners": false
#  }
#
# Here's a description of each option.
#
# =over
#
# =item "template": STRING (default: "signpost")
#
# The LaTeX genealogytree package provides a set of predefined styles for a
# genealogytree graph.  This option applies one of those styles.  Because the
# purpose of this program is currently to generate descendancy diagrams, which
# is a specific kind of genealogytree graph, only a subset of the
# templates--those that pertain to this kind--are supported.  These are listed
# below.
#
# =over
#
# =item * signpost
#
# =item * database pole
#
# =item * database portrait
#
# =item * database traditional
#
# =item * database sideways
#
# =back
#
# Note that variations of base templates are handled using other configuration
# parameters.  For example, the genealogytree package provides a base template
# C<database pole> with three adjacent templates:
#
# =over
#
# =item * database pole reduced
#
# =item * database poleportrait
#
# =item * database poleportrait reduced
#
# =back
#
# In our program, the user need only supply the base template.  The correct
# variation of the base template is chosen depending on the values of the
# configuration parameters C<reduce_output> and C<display_images>.
#
# =item "pretty_print": BOOLEAN (default: true)
#
# Recall that this program outputs LaTeX source code.  Primarily, it outputs a
# genealogytree graph file wrapped in just enough tex code to compile as a
# standalone image.
#
# If set to true, this option pretty-prints the genealogytree graph code in a
# manner consistent with the example graph files provided in the genealogytree
# manual.  If set to false, the graph code is condensed to one line with minimal
# spacing.
#
# =item "indent_string": STRING (default: "S<  >")
#
# This option determines the kind of indentation used in the resulting graph
# code if pretty-printing.  Some permissible values are listed.
#
# =over
#
# =item * "\t"
#
# =item * "S<  >"
#
# =item * "S<    >"
#
# =item * "S<        >"
#
# =back
#
# =item "reduce_output": BOOLEAN (default: false)
#
# Some genealogytree templates support a reduced form that produces a
# scaled-down version of the image it would otherwise produce.  This option, if
# set to true, uses the reduced form of a template if the template supports it.
#
# This setting is relevant when the dataset is large.  The LaTeX engine can
# crash with an arithmetic overflow if it runs out of space, i.e., when the
# family tree becomes too large, usually width-wise.
#
# =item "display_images": BOOLEAN (default: true)
#
# If true, display a portrait of each individual in the family tree for whom
# paths to image files are provided.  If false, do not display images even where
# paths to image files are provided.
#
# =item "exclude_partners": BOOLEAN (default: false)
#
# If true, include only consanguineous individuals in the family tree, those
# born into the family.  If false, include both consanguineous and affinal
# individuals in the family tree, those either born or married into the family.
#
# =back
#
# =head1 EXAMPLES
#
# This example centers on the genealogy of the biblical Book of Genesis.  Note
# that while the canonical Bible has Eve as Adam's first and only wife,
# extra-biblical folklore retains that Eve was the successor of Adam's estranged
# wife Lilith who came first.  We include her in this example to showcase how
# our program handle's multiple consecutive partnerships.
#
# =head2 Input
#
#     ,---- [ family-tree.json ]
#   1 | {
#   2 |   "name": "Adam",
#   3 |   "gender": "male",
#   4 |   "partners": [
#   5 |     {
#   6 |       "name": "Lilith",
#   7 |       "gender": "female"
#   8 |     },
#   9 |     {
#  10 |       "name": "Eve",
#  11 |       "gender": "female"
#  12 |     }
#  13 |   ],
#  14 |   "children": [
#  15 |     {
#  16 |       "name": "Cain",
#  17 |       "gender": "male",
#  18 |       "parent_index": 1,
#  19 |       "children": [
#  20 |         {
#  21 |           "name": "Enoch",
#  22 |           "gender": "male"
#  23 |         }
#  24 |       ]
#  25 |     },
#  26 |     {
#  27 |       "name": "Abel",
#  28 |       "gender": "male",
#  29 |       "parent_index": 1
#  30 |     },
#  31 |     {
#  32 |       "name": "Seth",
#  33 |       "gender": "male",
#  34 |       "parent_index": 1,
#  35 |       "children": [
#  36 |         {
#  37 |           "name": "Enos",
#  38 |           "gender": "male"
#  39 |         }
#  40 |       ]
#  41 |     }
#  42 |   ]
#  43 | }
#     `----
#
# =head2 Output
#
#     ,---- [ family-tree.tex ]
#   1 | \documentclass{standalone}
#   2 | \usepackage[all]{genealogytree}
#   3 | \usepackage{lmodern}
#   4 | \begin{document}
#   5 | \begin{tikzpicture}
#   6 | \genealogytree[
#   7 |         template=signpost,
#   8 |         insert phantom for childless families,
#   9 |         insert for childless families level limit = -2
#  10 | ]{
#  11 | child {
#  12 |         g[male]{Adam}
#  13 |         p[female]{Lilith}
#  14 |         union {
#  15 |                 p[female]{Eve}
#  16 |                 child {
#  17 |                         g[male]{Seth}
#  18 |                         c[male]{Enos}
#  19 |                 }
#  20 |                 child {
#  21 |                         g[male]{Cain}
#  22 |                         c[male]{Enoch}
#  23 |                 }
#  24 |                 c[male]{Abel}
#  25 |         }
#  26 | }}
#  27 | \end{tikzpicture}
#  28 | \end{document}
#     `----
#
# =head1 AUTHOR
#
# Zachary Krepelka L<https://github.com/zachary-krepelka>
#
# =head1 SEE ALSO
#
# =over
#
# =item L<https://github.com/T-F-S/genealogytree>
#
# =item L<https://github.com/torfsen/gedcom2gtr>
#
# =back
#
# =cut

