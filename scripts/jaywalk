#!/usr/bin/env bash

# FILENAME: jaywalk
# AUTHOR: Zachary Krepelka
# DATE: Monday, August 11th, 2025
# ABOUT: recursive json file accumulator
# ORIGIN: https://github.com/zachary-krepelka/genealogy.git
# UPDATED: Friday, July 31st, 2026 at 7:48 PM

# Functions --------------------------------------------------------------- {{{1

# for command-line infrastructure {{{2

program="${0##*/}"

usage() {
	local message

	IFS= read -r -d '' message <<-EOF || true
	Recursive JSON File Accumulator with Resource Binding

	Usage:
	  bash $program [-hH] [-k <key>] [-{b|B} <fld:res>]... <dir> <filename>

	Options:
	  -k <key>      change name of [k]ey under which objects are nested
	  -b <fld:res>  [b]ind file resource to each object if present
	  -B <fld:res>  [B]ind sequential file resources to each object
	                Both sides must contain exactly one printf format
	                specifier for an unsigned integer, i.e., %u

	Documentation:
	  -h  display this [h]elp message and exit
	  -H  read documentation for this script then exit
	EOF
	printf '%s' "$message"
}

documentation() {
	pod2text "$0" | less -Sp '^[^ ].*$' +k
}

error() {
	local code="$1" message="$2"
	echo "$program: error: $message" >&2
	exit "$code"
}

warn() {
	local message="$1"
	echo "$program: warning: $message" >&2
}

check_dependencies() {

	local dependencies=(find jq less paste pod2text realpath sed wc)

	local cmd missing= code="$1"

	for cmd in "${dependencies[@]}"
	do
		if ! command -v "$cmd" &>/dev/null
		then missing+="$cmd, "
		fi
	done

	if test -n "$missing"
	then error "$code" "missing dependencies: ${missing%, }"
	fi
}


# for core logic {{{2

walk() {
	local directory="$1"

	if has_children "$directory"
	then
		jq -s ".[0] + {\"$key\": .[1:]}" \
			<(get_json "$directory") \
			<(get_children "$directory")
	else
		get_json "$directory"
	fi
}

has_children() {
	test $(find "$1" -mindepth 1 -maxdepth 1 -type d | wc -l) -ne 0
}

get_children() {
	find "$1" -mindepth 1 -maxdepth 1 -type d -exec bash -c "walk '{}'" \;
}

get_json() {

	eval "$serialized_resources; $serialized_resource_types"

	{

	echo .

	for res_field in "${!resources[@]}"
	do
		res_file="${resources[$res_field]}"
		res_type="${resource_types[$res_field]}"

		case "$res_type" in
			standalone)
				res_path="$directory/$res_file"

				if test -f "$res_path"
				then
					res_path="$(realpath "$res_path")"
					echo "$res_field = \"$res_path\""
				fi
			;;
			sequential)
				max=$(get_largest_existing_index "$directory" "$res_file")

				for ((i = 0; i <= max; i++))
				do
					fmt_res_field="$(printf "$res_field" $i)"
					fmt_res_file="$(printf "$res_file" $i)"
					    res_path="$directory/$fmt_res_file"

					if test -f "$res_path"
					then
						res_path="$(realpath "$res_path")"
						echo "$fmt_res_field = \"$res_path\""
					fi
				done
			;;
		esac
	done

	} | paste -sd\| | jq -f /dev/stdin "$directory/$target"
}

get_largest_existing_index() {

	# HACK matches on a regex built from an arbitrary filename
	# TODO refactor to remove pitfall `for file in $(find)`
	# SEE  https://mywiki.wooledge.org/BashPitfalls

	local directory="$1" filename="$2" largest=-1 file index

	local re_find="${filename//%u/[0-9]+}"; re_find="${re_find/./\.}"
	local re_sed="${filename//%u/\\([0-9]\\+\\)}"; re_sed="${re_sed/./\.}"

	for file in $(find "$directory" -mindepth 1 -maxdepth 1 -type f -regex ".*/$re_find")
	do
		index=$((10#$(sed "s/$re_sed/\\1/" <<< "${file##*/}")))
		if test $index -ge $largest
		then largest=$index
		fi
	done

	echo "$largest"
}

# }}}

# Command-line Option Parsing --------------------------------------------- {{{1

declare opt_{help,doc,invalid}=false

declare -A resource{,_type}s

key=children

while getopts ':b:B:hHk:' opt
do
	case "$opt" in
		b|B) resources["${OPTARG%:*}"]="${OPTARG##*:}";;&
		b) resource_types["${OPTARG%:*}"]=standalone;;
		B) resource_types["${OPTARG%:*}"]=sequential;;
		h) opt_help=true;;
		H) opt_doc=true;;
		k) key="$OPTARG";;
		*) opt_invalid=true; invalid_opt+="$OPTARG";;
	esac
done

shift $((OPTIND - 1))

# Option Handling --------------------------------------------------------- {{{1

# Options are handled after they are parsed to enforce a consistent
# order of evaluation. If options were handled in the getopts loop as
# they are parsed, the order of evaluation would depend on the order
# that the user passed the options.

if $opt_help
then
	usage # does not use external commands
	exit 0
fi

check_dependencies 1 # must be called before any external command

if $opt_doc
then
	documentation # uses external commands
	exit 0
fi

if $opt_invalid
then
	warn "unknown options: -$invalid_opt"
fi

# Argument Handling ------------------------------------------------------- {{{1

if test $# -ne 2
then error 2 'exactly two arguments are required'
fi

path="${1%/}" target="$2"

if ! test -d "$path"
then error 3 '<path> is not a directory'
fi

# Main Processing --------------------------------------------------------- {{{1

export \
	key \
	target \
	serialized_resources=$(declare -p resources) \
	serialized_resource_types=$(declare -p resource_types)

export -f \
	walk \
	get_json \
	{has,get}_children \
	get_largest_existing_index

walk "$path" || error 4 "Something went wrong. You're on your own. Good Luck."

# Documentation ----------------------------------------------------------- {{{1

: <<='cut'
=pod

=head1 NAME

jaywalk - recursive json file accumulator with resource binding

=head1 SYNOPSIS

 bash jaywalk [-hH] [-k <key>] [-{b|B} <fld:res>]... <dir> <filename>

=head1 DESCRIPTION

This program accumulates JSON files dispersed throughout a directory
structure into a single, nested JSON object.  Every subdirectory of
<dir> should contain a JSON file whose filename is <filename>.

Options are provided for binding file resources to each JSON object in
the tree.  Every subdirectory of <dir> should optionally contain a file
whose filename is <res>.  The filepath of each <res> will be bound to
the <fld> key of each JSON object <filename> provided that <res> exists
in the same directory as <filename>.

My motive for writing this script was to ease the process of editing a
nested JSON file.  Rather than editing one large file, I can edit
individual files while using shell commands to traverse the directory
structure.  Thereafter, the individual files may be assembled into one
large file with the hierarchical relationship preserved.  Individual
objects within the tree are more readily targeted this way.  For
example, by using this script in conjunction with the command C<find
-exec vim +>, Vim macros may be executed over each object in the tree
for complex editing operations.

=head1 OPTIONS

The following options are available.

=over

=item B<-h>

Display a [h]elp message and exit.

=item B<-H>

Display this documentation in a pager and exit after the user quits.
The documentation is divided into sections.  Each section header is
matched with a search pattern, meaning that you can use navigation
commands like C<n> and its counterpart C<N> to go to the next or
previous section respectively.

=item B<-k> I<KEY>

This option changes the name of the [k]ey under which objects are
nested. The default key is C<children>.

=item B<-b> I<FIELD>:I<RESOURCE>

This option [b]inds a unique file I<RESOURCE> to each JSON object as
I<FIELD> if it is present.  That is, for each targeted JSON file X, if
I<RESOURCE> exists in the same directory as X, then bind the path of
I<RESOURCE> as a string to the key I<FIELD> of X before it is
assimilated into the nested JSON structure.  Note that I<FIELD> is a jq
path expression and therefore must begin with a dot, e.g.,
C<.foo.bar[42].baz>.  Here is an example in context.

 bash jaywalk -b .image:portrait.jpg family-tree/ person.json

This option is cumulative and can be specified multiple times. Each
unique I<FIELD> inserts a new file resource. If a duplicate I<FIELD> is
provided, the last specified I<RESOURCE> overwrites prior entries for
that I<FIELD>.

In regard to the use of a colon character in either the key or the
value, note that the key is read greedily, whereas the value is read
lazily.  This means that the jq path expression I<FIELD> may contain as
many colons as needed, whereas the I<RESOURCE> cannot have colons.

=item B<-B> I<FIELD>:I<RESOURCE>

This option [B]inds unique, sequentially-named file resources (note the
s) to each JSON object if they are present.  This option is like its
lowercase counterpart but induces an implicit for loop over its
parameters.  Namely, each half of the key-value pair must contain
exactly one printf format specifier for an unsigned integer, that is,
C<%u>.  As a matter of comparison, this

 -B .images[%u]:portrait%u.jpg

is approximately equivalent to this.

 -b .images[0]:portrait0.jpg -b .images[1]:portrait1.jpg ...

Here is a complete example in context.

 bash jaywalk -B .image_at_every_year_of_life[%u]:age%u.jpg family-tree/ person.json

Like B<-b>, this option is cumulative.

=back

=head1 EXAMPLES

Consider the following directory structure.

 Skywalker/
 `-- Anakin/
     |-- bio.json
     |    [ {
     |    [   "name": "Anakin Skywalker"
     |    [ }
     |-- Leia/
     |   |-- bio.json
     |   |    [ {
     |   |    [   "name": "Leia Skywalker"
     |   |    [ }
     |   `-- Ben/
     |       `-- bio.json
     |            [ {
     |            [   "name": "Ben Solo"
     |            [ }
     `-- Luke/
         `-- bio.json
              [ {
              [   "name": "Luke Skywalker"
              [ }

 5 directories, 4 files

Run the program with the following arguments.

 bash jaywalk Skywalker/Anakin bio.json

This gives the following.

 {
   "name": "Anakin Skywalker",
   "children": [
     {
       "name": "Leia Skywalker",
       "children": [
         {
           "name": "Ben Solo"
         }
       ]
     },
     {
       "name": "Luke Skywalker"
     }
   ]
 }

This is easily parsed using the command-line JSON processor C<jq>.

 bash jaywalk Skywalker/Anakin bio.json | jq -r 'recurse(.children[]?).name'

This gives the following.

 Anakin Skywalker
 Leia Skywalker
 Ben Solo
 Luke Skywalker

=head1 DIAGNOSTICS

The program exits with the following status codes.

=over

=item 0 if okay

=item 1 if dependencies are missing

=item 2 if the wrong number of positional arguments are passed

=item 3 if the first positional argument is not a directory

=item 4 for some other unforeseen error

=back

=head1 NOTES

The name of this program is a portmanteau of the words I<JSON> and
I<walk> with the I<J> in I<JSON> stressed as I<jay>.  It is a pun on the
crime of jaywalking.  A friend of mine had commented that nesting
folders deeply is cumbersome, remarking how much assembly code is
involved.  To that end, the use of this script is jokingly a crime.

=head1 AUTHOR

Zachary Krepelka L<https://github.com/zachary-krepelka>

=cut
